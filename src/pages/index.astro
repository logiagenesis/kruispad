---
import BaseLayout from "../layouts/BaseLayout.astro";

const title = "Kruispad Hazeldean";
const description =
  "Kruispad Hazeldean is ’n gemeente in Pretoria. Sondagoggend erediens 09:30–10:30 en Café Berea 17:30–18:30 by Curro Hazeldean.";
---

<BaseLayout title={title} description={description}>
  <header class="wrap head">
    <img
      class="logo"
      src={`${import.meta.env.BASE_URL}images/source/kruispad-logo.jpg`}
      width="280"
      height="280"
      alt="Kruispad Hazeldean-logo: ’n goue kruis met die woorde A Way of Life"
    />
    <p class="eyebrow">Gemeente · Pretoria</p>
    <h1>Kruispad Hazeldean</h1>
    <p class="lead">
      Die nuwe webwerf word tans gebou. Sondag se ritme bly dieselfde.
    </p>
  </header>

  <main id="inhoud" class="wrap">
    <section class="rhythm" aria-labelledby="sondag">
      <h2 id="sondag">Sondag by Curro Hazeldean</h2>
      <ul>
        <li>
          <strong>09:30–10:30</strong>
          <span>Erediens</span>
        </li>
        <li>
          <strong>17:30–18:30</strong>
          <span>Café Berea</span>
        </li>
      </ul>
      <p>
        Curro Hazeldean Primary / Curro Private School, 1 Silver Lakes Road,
        Hazeldean / Silver Lakes, Pretoria, 0081.
      </p>
    </section>

    <p class="actions">
      <a class="btn" href="tel:+27718829815">Bel 071 882 9815</a>
      <a class="btn btn-ghost" href="https://www.kruispadhazeldean.co.za/">
        Huidige webwerf
      </a>
    </p>
  </main>

  <footer class="wrap foot">
    <p>Kantoor: 071 882 9815 · Ma–Do 08:00–16:00 · Vr 08:00–12:00</p>
  </footer>
</BaseLayout>

<style>
  .wrap {
    width: min(880px, calc(100% - 2rem));
    margin-inline: auto;
  }

  .head {
    padding: 2.5rem 0 1rem;
  }

  .logo {
    width: min(220px, 60vw);
    height: auto;
    display: block;
    background: white;
    border-radius: 1.25rem;
    box-shadow: 0 10px 30px rgba(28, 20, 16, 0.08);
  }

  .eyebrow {
    margin: 1.4rem 0 0.2rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    font-size: 0.78rem;
    font-weight: 700;
    color: var(--color-ember-deep);
  }

  h1 {
    font-family: var(--font-display);
    font-size: clamp(2.6rem, 7vw, 4.6rem);
    line-height: 0.95;
    font-weight: 680;
    margin: 0;
    letter-spacing: -0.03em;
  }

  .lead {
    font-size: 1.2rem;
    max-width: 36rem;
    color: var(--color-ink-soft);
  }

  .rhythm {
    background: var(--color-paper);
    border: 1px solid var(--color-line);
    border-radius: 1.25rem;
    padding: 1.25rem 1.25rem 0.4rem;
  }

  h2 {
    font-family: var(--font-display);
    font-size: 1.7rem;
    margin: 0 0 0.8rem;
  }

  ul {
    list-style: none;
    padding: 0;
    margin: 0 0 0.6rem;
    display: grid;
    gap: 0.75rem;
  }

  @media (min-width: 640px) {
    ul {
      grid-template-columns: 1fr 1fr;
    }
  }

  li {
    background: var(--color-sand);
    border-radius: 0.9rem;
    padding: 0.9rem 1rem;
    display: flex;
    flex-direction: column;
  }

  li strong {
    font-family: var(--font-display);
    font-size: 1.45rem;
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin: 1.25rem 0 2rem;
  }

  .btn {
    display: inline-flex;
    align-items: center;
    min-height: 48px;
    padding: 0.65rem 1rem;
    border-radius: 999px;
    background: var(--color-ember);
    color: white;
    text-decoration: none;
    font-weight: 700;
  }

  .btn-ghost {
    background: transparent;
    color: var(--color-ink);
    border: 1px solid var(--color-line);
  }

  .foot {
    padding-bottom: 2.5rem;
    color: var(--color-ink-soft);
    font-size: 0.95rem;
  }
</style>
